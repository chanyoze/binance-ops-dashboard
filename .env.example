# ============================================================
#  실행 방법
#    cp .env.example .env
#    docker compose up
#  모든 값에 기본값이 있으므로 그대로 두어도 동작합니다.
# ============================================================

# ---------- Database ----------
POSTGRES_USER=binance
POSTGRES_PASSWORD=binance
POSTGRES_DB=binance_ops
POSTGRES_PORT=5432

# **호스트에서 직접 실행할 때만** 쓰이는 접속 문자열입니다 (npm run dev:* , npm test).
#
# docker compose 로 띄우면 이 값은 쓰이지 않습니다. compose 는 위의
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 로 컨테이너 네트워크용 URL 을
# 직접 조립해 각 서비스에 넘깁니다. 그러니 여기를 외부 DB 로 바꿔도
# compose 안의 서비스는 여전히 컨테이너 Postgres 를 봅니다.
# 외부 DB 를 쓰려면 docker-compose.yml 의 DATABASE_URL 을 고치세요.
DATABASE_URL=postgresql://binance:binance@localhost:5432/binance_ops


# ---------- Collector : 수집 대상 ----------
# 쉼표로 구분. 심볼을 늘려도 코드 변경이 필요 없습니다.
SYMBOLS=BTCUSDT,ETHUSDT

# 1분봉만 수집하고 상위 인터벌(5m/1h)은 SQL 집계로 만듭니다. (docs/DECISIONS.md D-05)
KLINE_INTERVAL=1m

# 최초 실행 시 백필할 과거 기간(일). DB가 비어 있을 때만 사용됩니다.
BACKFILL_DAYS=7


# ---------- Collector : 안정성 ----------
# 이 시간 동안 WS 메시지가 하나도 없으면 '좀비 연결'로 간주하고 강제 재접속합니다.
# BTCUSDT/ETHUSDT 는 초당 수 건이 오는 종목이므로 10초 무소식은 정상일 수 없습니다.
# (docs/DECISIONS.md D-04)
STALE_THRESHOLD_MS=10000

# 재연결 지수 백오프: 1s -> 2s -> 4s ... 최대 30s (+ jitter)
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=30000

# 무결성 스캐너 주기 — 1분봉 연속성을 검사해 구멍을 찾아 메웁니다.
INTEGRITY_SCAN_INTERVAL_MS=60000


# ---------- Binance API ----------
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443

# IP당 6,000 weight/분. 80% 도달 시 자동으로 요청을 늦춥니다. (docs/DECISIONS.md D-06)
RATE_LIMIT_WEIGHT_PER_MIN=6000
RATE_LIMIT_SOFT_THRESHOLD=0.8


# ---------- Web ----------
# **호스트에서 직접 실행할 때만** 쓰이는 포트입니다 (npm run dev:web).
# compose 안의 컨테이너는 항상 3000 을 듣습니다 — 헬스체크와 포트 매핑이
# 같은 값을 봐야 해서 고정했습니다.
PORT=3000

# `docker compose up` 이 호스트에 노출할 포트입니다.
# 브라우저에서 http://localhost:<WEB_PORT> 로 접속합니다.
#
# 3000 이 이미 쓰이면 여기만 바꾸세요. 안 바꾸면 포트 충돌로 `up` 자체가 실패하고
# 수집기까지 못 뜹니다.
# (Windows 는 Hyper-V 가 일부 구간을 예약해 3000 을 못 쓸 수 있습니다 —
#  `netsh interface ipv4 show excludedportrange protocol=tcp` 로 확인)
WEB_PORT=3000

LOG_LEVEL=info
